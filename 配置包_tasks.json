{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动LiveServer",
      "type": "shell",
      "command": "npx",
      "args": ["live-server", "--port=5500", "--host=localhost"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Serving",
          "endsPattern": ".$"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "启动LiveServer(Chrome)",
      "type": "shell",
      "command": "npx",
      "args": ["live-server", "--port=5500", "--browser=chrome"],
      "isBackground": true,
      "problemMatcher": [],
      "group": "none",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "安装npm依赖",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "problemMatcher": [],
      "group": "none"
    }
  ]
}
