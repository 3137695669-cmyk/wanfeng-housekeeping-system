<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!-- 单 datanode，副本数 1（演示环境） -->
  <property>
    <name>dfs.replication</name>
    <value>1</value>
  </property>
  <!-- Docker 网络里用主机名访问 datanode（否则客户端可能拿到容器 IP 连不上） -->
  <property>
    <name>dfs.client.use.datanode.hostname</name>
    <value>true</value>
  </property>
</configuration>
